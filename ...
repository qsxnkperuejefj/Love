        font-size: 16px;
        box-shadow: 0 6px 20px rgba(200, 160, 220, 0.35);
    }
    .btn:hover { transform: translateY(-2px); }
    .back { display: inline-block; margin-top: 24px; color: #9a8ac0; text-decoration: none; font-size: 14px; }
