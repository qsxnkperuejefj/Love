import os

# === ОБХОД ОШИБКИ WERKZEUG_SERVER_FD ===
# Это заставляет Werkzeug думать, что он запущен в дочернем процессе
os.environ['WERKZEUG_RUN_MAIN'] = 'true'

from flask import Flask, Response

app = Flask(__name__)

STYLE = """
